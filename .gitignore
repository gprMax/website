# Local build
_site/
.jekyll-cache/
.jekyll-metadata
vendor/
.bundle/

# Not part of the deployed site (kept in local backup)
offline/
extras/

# Retired Apache/PHP era — kept locally for reference during migration.
# Anchored with a leading slash: a bare `scripts/` matches a directory of
# that name at ANY depth, which silently swallowed .github/scripts/ and
# left the stats workflow running a file that was never committed.
/scripts/
users/submit_pin.php

# Superseded by _includes/ — kept locally until the migration is signed off
ssi/

# The user map. users/pins.geojson is the MINIMISED file, generated by
# tools/minimise_pins.py and deliberately committed: it carries only the
# three properties the map reads, with names, Padlet permalinks, email
# addresses in notes, and excess coordinate precision removed. Everything
# else in users/ stays private -- pins.source.geojson is the full archive,
# and submit_pin.php is the retired Apache endpoint.
#
# Note the trailing star: `users/` alone stops git descending into the
# directory, and a negation below it would never be reached.
users/*
!users/pins.geojson

# OS noise
.DS_Store

# Cloudflare Worker: local secrets and build state, never committed.
worker/.dev.vars
worker/node_modules/
worker/.wrangler/
