{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gprmax-usermap",
	"main": "src/index.js",
	"compatibility_date": "2026-08-28",

	// Rate-limit ledger and the geocode cache. Nominatim's usage policy asks
	// that results be cached rather than re-queried, and caching also keeps
	// us far inside the 1 req/sec ceiling.
	//
	// The id is not a credential -- reaching the namespace still needs
	// account auth -- so it lives in version control like any other
	// binding. Local `wrangler dev` simulates KV and ignores it.
	"kv_namespaces": [
		{ "binding": "MAP_STATE", "id": "8f5076ecc4c34dd0879ddceb59f5d25d" }
	],

	"observability": { "enabled": true }
}
